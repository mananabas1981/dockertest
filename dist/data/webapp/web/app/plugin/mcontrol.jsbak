export class DropDown extends Panel {

  /*
    const drop = new DropDown("Menu", "success").setStyle({
        marginRight: "10px"
    });
    drop.addItem(`<i class="fa fa-edit"></i> hellow`, () => {
        alert("hellow2");
    });
    drop.addItem(`<i class="fa fa-envelop"></i> hellow 2`, () => {
        alert("hellow2fdsafd");
    });
  
  */
  constructor(title, type = "default", hint = "") {
    super();
    this.addClass("dropdown");
    this.setStyle({
      "display": "inline-block"
    });

    const btn = new Button(`${title}` + ` <span class="caret"></span>`, type, null, hint);
    this.add(btn);
    

    this.ul = document.createElement("ul");
    this.ul.setAttribute("class", "dropdown-menu");

    this.add(this.ul);
    
    this.toggle = false;

    btn.addEventListener("click", () => {
      this.show();
    });
  }
  show() {
    this.toggle = !this.toggle;
      // update the ul
    this.ul.style.display = this.toggle ? "block" : "none";
  }

  addItem(html, fn) {
    const li = document.createElement("li");
    this.ul.appendChild(li);

    const link = document.createElement("a");
    link.setAttribute("href", "#");
    link.innerHTML = html;

    li.appendChild(link);

    if (typeof(fn) == "function") {
      link.addEventListener("click", (e) => {
        fn();
        this.show();
        e.preventDefault();
      });
    }
  }

  clear() {
    this.ul.innerHTML = '';
  }
}


class BasicTab extends Panel {
  constructor() {
    super();

    this.ul = _.c("ul");
    this.ul.setAttribute("class", "nav nav-tabs");
    
    this.list = [];

    this.content = new Panel();
    super.add([this.ul, this.content]);
  }

  _clearactive() {
    for (const item of this.list) {
      item.classList.remove("active");
    }
  }

  add(name, fn, is_active = false) {
    const li = _.c("li"); 
    li.innerHTML = `<a href="#">${name}</a>`;
    this.ul.appendChild(li);
    this.list.push(li);

    li.addEventListener("click", () => {
      this._clearactive();
      this.content.clear();
      li.classList.add("active");
      fn(this.content);
    });
    // trigger if it is active
    if (is_active) {
      this._clearactive();
      this.content.clear();
      li.classList.add("active");
      fn(this.content);
    }
  }

}


class DropdownTab extends Panel {
  constructor() {
    super();

    this.ul = _.c("ul");
    this.ul.setAttribute("class", "nav nav-tabs");
    
    this.list = [];

    this.content = new Panel();
    super.add([this.ul, this.content]);

    this.lis = [];
  }

  _clearactive() {
    for (const item of this.list) {
      item.classList.remove("active");
    }
  }

  add(name, arr, is_active = false) {
    const li = _.c("li"); 
    this.ul.appendChild(li);
    this.list.push(li);
    const arr_len = arr.length;
    
    if (arr_len >= 0) {
      li.classList.add("dropdown");
      const a = _.c("a");
      a.classList.add("dropdown-toggle");
      a.setAttribute("data-toggle", "dropdown");
      a.setAttribute("href", "#");
      a.innerHTML =`${name} <span class="caret"></span>`;
      a.setAttribute("aria-expanded", "true");
      a.style.fontSize = "12px";
      li.appendChild(a);

      const ul = _.c("ul");
      ul.classList.add("dropdown-menu");
      

      let toggle = false;
      li.addEventListener("click", () => {
        toggle = !toggle;
        if (toggle) {
          ul.style.display = "block";
        } else {
          ul.style.display = "none";
        }
      });

      for (let i = 0; i < arr_len; i++) {
        const li = _.c("li");
        li.innerHTML = `<a href="#">${arr[i][0]}</a>`;
        this.lis.push(li);

        li.addEventListener("click", () => {
          
          for (const s of this.lis) {
            s.classList.remove("active");
          }

          li.classList.add("active");
          this.content.clear();
          
          const fn = arr[i][1];

          fn(this.content);
        });

        ul.appendChild(li);
      }


      li.appendChild(ul);

    }

    li.addEventListener("click", () => {
      this._clearactive();
      //this.content.clear();
      li.classList.add("active");
      // fn(this.content);
    });
    // trigger if it is active
    if (is_active) {
      this._clearactive();
      //this.content.clear();
      li.classList.add("active");
      // fn(this.content);
    }
  }

}


export {
  BasicTab,
  DropdownTab
};


